{
  "name": "cp-migration-tool",
  "version": "1.5.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "cd apps/web && prisma generate",
    "clear": "sh scripts/clear-ports.sh; rm -rf apps/web/.next .turbo node_modules/.cache",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "cd apps/web && next start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "cd apps/web && prisma generate",
    "db:push": "cd apps/web && prisma db push",
    "db:studio": "cd apps/web && prisma studio",
    "cleanup": "cd apps/web && npm run cleanup",
    "release:check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "audit": "npm audit --production",
    "precommit": "npm run lint && npm run typecheck",
    "start:express-paloalto": "node server.js"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prettier": "^3.2.5",
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.2.0",
  "dependencies": {
    "@cisco2cp/exporters": "*",
    "@cisco2cp/parsers": "*",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.5.10",
    "joi": "^18.1.2",
    "multer": "^2.1.1",
    "uuid": "^13.0.0"
  }
}

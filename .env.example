# =============================================================================
# Migrator — Environment Variables
# Copy to apps/web/.env and adjust values. Never commit .env to version control.
# =============================================================================

# --- Database ---
DATABASE_URL=file:./data/dev.db

# --- Authentication ---
# Admin login. Create additional users via Settings.
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# --- Session (REQUIRED in production) ---
# JWT signing secret. Must be at least 32 characters.
SESSION_SECRET=your-secret-key-minimum-32-characters-long

# --- Config Protection (optional) ---
# CONFIG_PIN=1234

# --- AI Validation Scaffold (optional) ---
# AI_VALIDATION_ENABLED=false
# AI_VALIDATION_OUTBOUND_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- File Upload ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# --- Logging ---
LOG_LEVEL=info

# --- Palo Alto (Express / PA → CP scaffold; optional) ---
PALO_ALTO_HOST=
PALO_ALTO_API_KEY=
PANORAMA_HOST=
PANORAMA_USERNAME=
PANORAMA_PASSWORD=
IMPORT_MAX_FILE_SIZE_MB=50
# PALO_ALTO_EXPRESS_PORT=3001
# PALO_ALTO_EXPRESS_API_KEY=        # Required when NODE_ENV=production; send as Authorization: Bearer <key> or X-API-Key
# PALO_ALTO_HOST_ALLOWLIST=         # Required in production unless PALO_ALTO_ALLOW_ANY_HOST=true — comma-separated hostnames/IPs
# PALO_ALTO_ALLOW_ANY_HOST=true     # Insecure: skip allowlist requirement in production (not recommended)
# PALO_ALTO_BLOCK_PRIVATE_HOSTS=true # Also block RFC1918 targets (stricter SSRF; breaks many internal firewalls)
# FMG_REQUEST_TIMEOUT_MS=120000     # FortiManager JSON-RPC fetch timeout (apps/web)
# ENABLE_HSTS=1                     # apps/web: emit Strict-Transport-Security (set only behind HTTPS)

# --- Application ---
NODE_ENV=development

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant & identity
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    TenantMembership[]
  identityProviders IdentityProvider[]
  settings       TenantSetting[]
  projects       Project[]
  userSessions  UserSession[]
  auditLogs      AuditLog[]
}

model User {
  id                       String   @id @default(uuid())
  username                 String   @unique
  email                    String?  @unique
  passwordHash             String
  // True once the user sets their own password in-app; disables env AUTH_PASSWORD override for this account.
  passwordChangedByUser    Boolean  @default(false)
  // Timestamp of the last password change/reset; JWTs issued before this are rejected.
  passwordChangedAt        DateTime?
  isInternalSupportIdentity Boolean  @default(false)
  isPlatformAdmin          Boolean  @default(false)
  ssoExternalId            String?
  ssoTenantSlug            String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenantMemberships    TenantMembership[]
  userSessions         UserSession[]
  platformAdminSessions PlatformAdminSession[]
  auditLogsAsActor    AuditLog[] @relation("AuditLogActor")
  projectMembers      ProjectMember[]

  @@unique([ssoExternalId, ssoTenantSlug])
  @@index([ssoExternalId])
}

model TenantMembership {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  role       String   // admin | member | viewer
  isPrimary  Boolean  @default(false)
  status     String   @default("active") // active | suspended | removed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status])
}

model IdentityProvider {
  id        String   @id @default(uuid())
  tenantId  String
  type      String   // saml | oidc | etc.
  config    String   // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  tenantId     String
  sessionToken String   @unique
  status       String   @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId, status])
  @@index([sessionToken])
}

model PlatformAdminSession {
  id                   String    @id @default(uuid())
  userId               String
  mode                 String    // SUPPORT
  status               String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  supportTargetTenantId String?
  elevatedAt           DateTime  @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?
  justification        String?
  approvedBy           String?
  ipAddress            String?
  userAgent            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AuditLog {
  id                     String   @id @default(uuid())
  actorUserId            String
  tenantId               String?
  platformAdminSessionId String?
  action                 String
  resourceType           String
  resourceId             String?
  result                 String   // success | failure
  details                String?  // JSON
  ipAddress              String?
  userAgent              String?
  createdAt              DateTime @default(now())

  actor User?  @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([tenantId, createdAt])
}

model TenantSetting {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  value     String   // JSON or string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Project & migration data (all tenant-scoped)
// ---------------------------------------------------------------------------

model Project {
  id             String   @id @default(uuid())
  tenantId       String?  // required after backfill; optional for migration
  name           String
  sourceType     String   // asa | ftd | both | fortinet | fortimanager | paloalto
  status         String   @default("draft")
  currentStep    String   @default("import")
  completedSteps String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant     Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artifacts  RawArtifact[]
  normalized NormalizedData?
  jobs       Job[]
  projectMembers ProjectMember[]

  @@index([tenantId, id])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   // owner | admin | editor | viewer
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model RawArtifact {
  id         String   @id @default(uuid())
  projectId  String
  tenantId   String?
  filename   String
  size       Int
  sha256     String
  content    String?
  sourceType String   // asa | ftd | fortinet | fortimanager | fortianalyzer | paloalto
  uploadedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model NormalizedData {
  id                  String   @id @default(uuid())
  projectId           String   @unique
  tenantId            String?
  objectsJson         String
  rulesJson           String
  natJson             String
  interfacesJson      String
  zonesJson           String
  warningsJson        String
  // Structured Fortinet→Check Point migration summary (JSON).
  migrationReportJson String   @default("{}")
  createdAt           DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model InterfaceMappingRecord {
  id               String   @id @default(uuid())
  projectId        String
  tenantId         String?
  asaInterfaceId   String
  cpInterfaceName  String
  cpIpOverride     String?
  cpMaskOverride   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([projectId, asaInterfaceId])
  @@index([tenantId])
}

model MappingDecisionRecord {
  id               String   @id @default(uuid())
  projectId        String
  tenantId         String?
  entityType       String
  sourceId         String
  proposedTarget   String
  confidenceScore  Float
  reasonsJson      String
  warningsJson     String
  userOverrideJson String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([projectId, entityType, sourceId])
  @@index([tenantId])
}

model ValidationOverride {
  id             String   @id @default(uuid())
  projectId      String
  tenantId       String?
  findingId      String
  acknowledgedAt DateTime @default(now())

  @@index([tenantId])
}

model Job {
  id           String   @id @default(uuid())
  projectId    String
  tenantId     String?
  type         String
  status       String   @default("queued")
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs    JobLog[]

  @@index([tenantId])
}

model JobLog {
  id        String   @id @default(uuid())
  jobId     String
  level     String
  message   String
  timestamp DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Platform / app config (not tenant-scoped)
// ---------------------------------------------------------------------------

model AppConfig {
  id               String   @id @default("default")
  modelFetchMethod String   @default("default")
  litellmBaseUrl   String?
  litellmModel     String?
  litellmApiKey    String?
  pinHash          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

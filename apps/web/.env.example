# =============================================================================
# Migrator — Environment Variables
# Copy to .env and adjust. Never commit .env to version control.
# For passwords with $ & ! etc, use quotes: AUTH_PASSWORD='MyPass$123'
# SESSION_SECRET must be at least 32 characters in production.
# =============================================================================

DATABASE_URL=file:./data/dev.db
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
SESSION_SECRET=your-secret-key-minimum-32-characters-long
# COOKIE_SECURE=false   # Set for HTTP (no HTTPS); uncomment for remote VM
# CONFIG_PIN=1234
# SSO_PARTNER_SECRET=   # Min 16 chars; when set, SSO redirects require sig+ts
# CRON_SECRET=          # For POST /api/cron/cleanup (manual/remote trigger)
# AI_VALIDATION_ENABLED=false  # Set true to enable scaffold AI validation endpoint
# AI_VALIDATION_OUTBOUND_ENABLED=false  # Set true to allow outbound OpenAI calls (redacted payload only)
# OPENAI_API_KEY=              # Keep server-side only; never expose in client
# OPENAI_MODEL=gpt-4o-mini     # Reserved for future provider calls
# CLEANUP_INTERNAL_ENABLED=false  # Disable internal scheduler (use external cron)
# CLEANUP_UPLOAD_DAYS=30
# CLEANUP_AUDIT_RETENTION_DAYS=365
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
LOG_LEVEL=info
NODE_ENV=development
